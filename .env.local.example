# Supabase Configuration (optional - for storing submissions)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Shopify store domain (.myshopify.com) used to build cart-permalink checkout links.
# Optional — defaults to nicanteen.myshopify.com in lib/shopify.ts.
NEXT_PUBLIC_SHOPIFY_DOMAIN=nicanteen.myshopify.com

# Resend Email API Key (required for contact form)
# Get your API key at https://resend.com
RESEND_API_KEY=re_your_api_key_here
